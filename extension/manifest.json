{
  "manifest_version": 3,
  "name": "PhishNet Warning",
  "version": "0.1.0",
  "description": "Warns about suspicious URLs using the local PhishNet API.",
  "permissions": ["storage", "tabs", "webNavigation", "notifications"],
  "host_permissions": ["http://localhost:8000/*", "https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "options_page": "options.html"
}
