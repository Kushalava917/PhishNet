{
  "manifest_version": 3,
  "name": "PhishNet",
  "version": "0.1.0",
  "description": "Open-source, explainable phishing warnings powered by a local PhishNet API.",
  "permissions": ["storage", "tabs", "webNavigation", "notifications"],
  "host_permissions": ["http://localhost:8000/*", "https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "PhishNet" },
  "options_page": "options.html"
}
